# This Dropbox folder is shared with non-site material (brand docs, photo
# references, inspiration...). Rather than list every such file/folder to
# exclude (fragile — anything new added later would leak into git), we
# ignore everything by default and only allow the real site files through.

/*

!/.gitignore
!/.htaccess
!/README.md
!/index.html
!/methode.html
!/accompagnement.html
!/apropos.html
!/ressources.html
!/cotignac.html
!/mentions-legales.html
!/confidentialite.html
!/contact.html
!/contact.php
!/buzon.php
!/mail-config.example.php
!/merci.html
!/robots.txt
!/sitemap.xml
!/google3724427637173598.html

!/css/
!/css/**

!/js/
!/js/**

!/lang/
!/lang/**

!/images/
!/images/**

# Working files kept next to the site images but not part of the site:
# inspiration folder, heavy original photos, and the "… - style hero" copies
# (the site uses the clean-named *-hero.jpg versions instead).
/images/Images d'inspiration/
/images/Travail.JPG
/images/Travail sur tableau 1.JPG
/images/Travail sur tableau 2.JPG
/images/Profil Web 1.JPG
/images/Tableau Creighton.jpg
/images/* - style hero.jpg
/images/Tu fertilidad.jpg
/images/Mama slow.jpg
/images/No morir nunca.jpg
/images/Pas à pas.JPG

!/lib/
!/lib/**

# mail-config.php holds a real Hostinger mailbox password — it is created
# directly on the server via File Manager, never through git. The allowlist
# above already excludes it by default; this line just makes that explicit.

# Cotignac originals (the site uses the clean-named copies)
/images/Saint Joseph.jpg
/images/Cartes 2026.jpeg
/images/Cartes 2026_2.jpeg
/images/Sanctuaire brulé.jpeg
/images/Source Saint Joseph.jpg
